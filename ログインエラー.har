le\":\"Set up NFC\",\"oie.enroll.nfc_pin.instructions\":\"Open Okta Verify and add your NFC device, then return here to set your PIN.\",\"oie.enroll.nfc_pin.openOktaVerify\":\"Open Okta Verify\",\"oie.enroll.nfc_pin.create.title\":\"Choose a PIN\",\"oie.enroll.nfc_pin.create.description\":\"When you sign in with NFC, you will also enter your PIN.\",\"oie.enroll.nfc_pin.create.pinLabel\":\"PIN\",\"oie.enroll.nfc_pin.create.confirmPinLabel\":\"Re-enter PIN\",\"oie.enroll.nfc_pin.create.error.match\":\"Your PINs must match.\",\"oie.enroll.nfc_pin.create.requirements.header\":\"Requirements:\",\"oie.enroll.nfc_pin.create.requirement.length\":\"Enter a {0}-digit PIN.\",\"oie.enroll.nfc_pin.create.error.numeric\":\"Your PIN can contain numbers only.\",\"oie.enroll.nfc_pin.create.error.requirementsNotMet.prefix\":\"PIN requirements were not met:\",\"oie.select.authenticators.enroll.title\":\"Set up security methods\",\"oie.select.authenticators.enroll.subtitle\":\"Security methods help protect your account by ensuring only you have access.\",\"oie.select.authenticators.enroll.subtitle.custom\":\"Security methods help protect your {0} account by ensuring only you have access.\",\"oie.setup.required\":\"Set up required\",\"oie.setup.optional\":\"Set up optional\",\"oie.setup.required.now\":\"Required now\",\"oie.setup.required.soon\":\"Required soon\",\"oie.setup.optional.short\":\"Optional\",\"oie.setup.required.soon.description\":\"When the deadline passes, you won’t be able to sign in until you complete setup.\",\"oie.setup.remind.me.later\":\"Remind me later\",\"oie.optional.authenticator.button.title\":\"Continue\",\"oie.verify.authenticator.button.text\":\"Select\",\"oie.enroll.authenticator.button.text\":\"Set up\",\"oie.enroll.authenticator.usage.text.access.recovery\":\"Used for access or recovery\",\"oie.enroll.authenticator.usage.text.recovery\":\"Used for recovery\",\"oie.enroll.authenticator.usage.text.access\":\"Used for access\",\"oie.select.authenticators.ver