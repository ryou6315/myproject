n-bg-image\"></div> <!--<![endif]-->\n\n<!-- hidden form for reposting fromURI for X509 auth -->\n<form action=\"/login/cert\" method=\"post\" id=\"x509_login\" name=\"x509_login\" class=\"hide\">\n    <input type=\"hidden\" id=\"fromURI\" name=\"fromURI\" class=\"hidden\" value=\"https&#x3a;&#x2f;&#x2f;nec-markeid.oktapreview.com&#x2f;oauth2&#x2f;v1&#x2f;authorize&#x3f;client_id&#x3d;0oa137pvmx2Aj2fnL1d8&amp;code_challenge&#x3d;gHsG8vKuDpiNf586cqG7Yn_8PAh18jsK8mrwVmikDGo&amp;code_challenge_method&#x3d;S256&amp;nonce&#x3d;GNTVZLC8LCkadAdRjsa8Wf2AY3r3TktIcTzJtPBo5oGJf1jP9KjMMr86pM2CBGDc&amp;redirect_uri&#x3d;http&#x25;3A&#x25;2F&#x25;2Flocalhost&#x25;3A3000&#x25;2Flogin&#x25;2Fcallback&amp;response_type&#x3d;code&amp;state&#x3d;34ssJzf33R0zy8aXKyjRC6HaVS2WAfn6QIJ7zbpndIZNzpXSWSO7gChvFyCnQUeV&amp;scope&#x3d;openid&#x25;20profile&#x25;20email&#x25;20offline_access\"/>\n</form>\n\n<div class=\"content\">\n  <div class=\"applogin-banner\">\n          <div class=\"applogin-background\"></div>\n          <div class=\"applogin-container\">\n              <h1>\n                  <span class=\"applogin-app-title\">\n                    以下に​接続中</span>\n                  <div class=\"applogin-app-logo\">\n                      <img src=\"https://op3static2.oktacdn.com/assets/img/logos/default.6770228fb0dab49a1695ef440a5279bb.png\" alt=\"FIDO2-TEST-REACT-APP\" class=\"logo oidc_client\"/></div>\n              </h1>\n              <p>自分の​アカウントに​サインインして​FIDO2-TEST-REACT-APPに​アクセスします</p>\n              </div>\n      </div>\n  <style type=\"text/css\" nonce=\"kHIagEE6BZPRPY82aX11Mw\">\n    .noscript-msg {\n        background-color: #fff;\n        border-color: #ddd #ddd #d8d8d8;\n        box-shadow:0 2px 0 rgba(175, 175, 175, 0.12);\n        text-align: center;\n        width: 398px;\n        min-width: 300px;\n        margin: 200px auto;\n        border-radius: 3px;\n        border-width: 1px;\n        border-style: solid;\n    }\n\n    .noscript-content {\n        padding: 42px;\n    }\n\n    .noscript-content h2 {\n        padding-bottom: 20px;\n    }\n\n    .noscript-content h1 {\n        padding-bottom: 25px;\n    }\n\n    .noscript-content a {\n        background: transparent;\n        box-shadow: none;\n        display: table-cell;\n        vertical-align: middle;\n        width: 314px;\n        height: 50px;\n        line-height: 36px;\n        color: #fff;\n        background: linear-gradient(#007dc1, #0073b2), #007dc1;\n        border: 1px solid;\n        border-color: #004b75;\n        border-bottom-color: #00456a;\n        box-shadow: rgba(0, 0, 0, 0.15) 0 1px 0, rgba(255, 255, 255, 0.1) 0 1px 0 0 inset;\n        -webkit-border-radius: 3px;\n        border-radius: 3px;\n    }\n\n    .noscript-content a:hover {\n        background: #007dc1;\n        cursor: hand;\n        text-decoration: none;\n    }\n </style><noscript>\n    <div id=\"noscript-msg\" class=\"noscript-msg\">\n        <div class=\"noscript-content\">\n            <h2>JavaScriptが​必要です</h2>\n            <h1>Javascriptが​ブラウザーで​無効です。&nbspJavaScriptを​有効化し、​この​ページを​更新してください。</h1>\n            <a href=\".\" class=\"tb--button\">更新</a>\n        </div>\n    </div>\n</noscript>\n<div id=\"signin-container\"></div>\n  <div id=\"okta-sign-in\" class=\"auth-container main-container hide\">\n      <div id=\"unsupported-onedrive\" class=\"unsupported-message hide\">\n        <h2 class=\"o-form-head\">お使いの​OneDriveバージョンが​サポートされていません</h2>\n        <p>Oktaに​ログインするには、​今すぐOneDrive for Business Next Generation Sync Clientを​インストールして​アップグレードしてください</p>\n        <a class=\"button button-primary tb--button\" target=\"_blank\" href=\"https://support.okta.com/help/articles/Knowledge_Article/Upgrading-to-OneDrive-for-Business-Next-Generation-Sync-Client\">\n          アップグレード方法に​ついて​学ぶ</a>\n      </div>\n      <div id=\"unsupported-cookie\" class=\"unsupported-message hide\">\n          <h2 class=\"o-form-head\">クッキーが​必要です</h2>\n          <p>クッキーが​ブラウザーで​無効に​なっています。​クッキーを​有効に​して、​この​ページを​更新してください。</p>\n          <a class=\"button button-primary tb--button\" target=\"_blank\" href=\".\">\n              更新</a>\n      </div>\n  </div>\n</div>\n\n<div class=\"footer\">\n  <div class=\"footer-container clearfix\">\n    <p class=\"privacy-policy\"><a href=\"/privacy\" target=\"_blank\" class=\"inline-block margin-l-10\">プライバシーポリシー</a></p>\n    </div>\n</div>\n\n<div id=\"inactive-tab-main-div\" class=\"hide\">\n    <div class=\"inactive-tab-container\">\n    <div class=\"inactive-tab-header\">\n        <img src=\"https://op3static2.oktacdn.com/fs/bco/1/fs042z7l5gSs0cDeo1d7\" alt=\"NEC-MarkeID\" class=\"report-org-logo\"/><div class=\"divider\"></div>\n    </div>\n    <div class=\"inactive-tab-content\">\n        <h2 class=\"inactive-tab-content-title\">ページが​タイムアウトに​なりました</h2>\n        <p class=\"inactive-tab-details\">この​ページは​自動的に​再読み込みされません。​ブラウザーを​更新してください。</p>\n    </div>\n</div>\n</div>\n<script nonce=\"kHIagEE6BZPRPY82aX11Mw\" type=\"text/javascript\">function runLoginPage (fn) {var mainScript = document.createElement('script');mainScript.src = 'https://op3static2.oktacdn.com/assets/js/mvc/loginpage/initLoginPage.pack.d4f8b33efa60705220b2a7cf56e43e20.js';mainScript.crossOrigin = 'anonymous';mainScript.integrity = 'sha384-xvT+v9DHCr9G8XFHtETRoFe6W2nuZH+aVDI3y+klzAqgVIjqSPRwlIOLTLkokjDK';document.getElementsByTagName('head')[0].appendChild(mainScript);fn && mainScript.addEventListener('load', function () { setTimeout(fn, 1) });}</script><script nonce=\"kHIagEE6BZPRPY82aX11Mw\" src=\"https://op3static2.oktacdn.com/assets/loginpage-render/okta-loginpage-render-0.2.10-71-gac626a6.js\" crossorigin=\"anonymous\" integrity=\"sha384-cOZ8F8cOwJbUatOP5n2M40KGhwP9SYzKMzBErAKxDrpmavzNYk3GePXZTcHCw8Qd\"></script><script nonce=\"kHIagEE6BZPRPY82aX11Mw\">\n    var stateToken = 'eyJ6aXAiOiJERUYiLCJhbGlhcyI6ImVuY3J5cHRpb25rZXkiLCJ2ZXIiOiIxIiwib2lkIjoiMDBvM2FvZ2dmMTdEelV5TWIxZDciLCJlbmMiOiJBMjU2R0NNIiwiYWxnIjoiZGlyIn0..jCNLFX0kN6ixw3Bw.3GmdbKkg7j5R2hjLW9WtKDh1fOjJVWbhJvVcrpj42